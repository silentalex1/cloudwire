# Server Configuration
PORT=10000
NODE_ENV=production

# Security Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-this
BOT_SECRET=your-bot-secret-change-this

# Allowed Origins (comma-separated)
ALLOWED_ORIGINS=https://cloudwire-frontend.onrender.com,https://www.cloudwire.cfd,https://cloudwire.cfd

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloudwire
DB_USER=postgres
DB_PASSWORD=your-database-password

# Redis Configuration (Optional - falls back to in-memory)
REDIS_URL=redis://localhost:6379

# DNS Configuration
DNS_PORT=5353
